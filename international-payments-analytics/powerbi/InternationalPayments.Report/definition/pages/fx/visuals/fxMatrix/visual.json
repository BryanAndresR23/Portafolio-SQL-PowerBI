                }
              },
              "queryRef": "dim_date.year",
              "nativeQueryRef": "year",
              "displayName": "Year"
            }
          ]
        },
        "Values": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
