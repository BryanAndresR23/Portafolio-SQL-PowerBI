            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "FX Volatility (annualised %)"
                }
              },
              "queryRef": "_Measures.FX Volatility (annualised %)",
              "nativeQueryRef": "FX Volatility (annualised %)",
              "displayName": "Volatility"
            }
          ]
        }
      }
    },
    "objects": {
      "grid": [
        {
          "properties": {
            "textSize": {
