              },
              "queryRef": "dim_currency.currency_name",
              "nativeQueryRef": "currency_name",
              "displayName": "Currency"
            }
          ]
        },
        "Columns": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
